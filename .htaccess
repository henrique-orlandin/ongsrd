<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect explicit /public URLs to clean root URLs.
    RewriteCond %{THE_REQUEST} \s/+[^\s]*public(?:/|\s|\?) [NC]
    RewriteRule ^public(?:/(.*))?$ $1 [R=301,L]

    # Prevent rewrite loops for already rewritten /public paths.
    RewriteRule ^public/ - [L]

    # Route all requests through the public/ front controller directory.
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
